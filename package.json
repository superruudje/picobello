{
  "name": "@superruudje/picobello",
  "version": "0.1.0-beta.3",
  "description": "Picobello design system – reusable Vue 3 UI components",
  "license": "MIT",
  "author": "Rudi Haamke <rjhaamke@gmail.com>",
  "type": "module",
  "files": [
    "dist/index.*",
    "dist/picobello.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/picobello.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "scripts": {
    "build": "vue-tsc -p tsconfig.build.json && vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "publish:beta": "npm publish --tag beta",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --check",
    "format:fix": "prettier . --write"
  },
  "keywords": [
    "vue",
    "vue3",
    "design-system",
    "ui",
    "components",
    "storybook"
  ],
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "dependencies": {
    "bootstrap-icons": "^1.13.2",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.6.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.6.3",
    "@storybook/addon-docs": "^10.6.3",
    "@storybook/addon-vitest": "^10.6.3",
    "@storybook/vue3-vite": "^10.6.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "sass": "^1.106.1",
    "storybook": "^10.6.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vite-plugin-dts": "^5.1.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^5.0.5",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  }
}
